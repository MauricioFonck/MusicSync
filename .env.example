APP_ENV=development
DATABASE_URL=sqlite:///./data/musicsync.db
DEFAULT_FORMAT=mp3
DEFAULT_QUALITY=192
DOWNLOAD_TEMP_DIR=./data/temp
LOG_DIR=./data/logs
# JSON list; empty = auto-discover drives (Windows letters, /media, /mnt, /run/media/$USER)
STORAGE_MOUNT_POINTS=[]
CORS_ORIGINS=["http://localhost:4200"]
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
YT_DLP_BINARY=yt-dlp
SPOTDL_BINARY=spotdl
